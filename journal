#!/usr/bin/env sh
# ai-work-journal CLI (Linux / macOS). The logic lives in journal.py.
SELF="$0"
while [ -L "$SELF" ]; do
  T="$(readlink "$SELF")"
  case "$T" in /*) SELF="$T" ;; *) SELF="$(dirname "$SELF")/$T" ;; esac
done
BASE="$(cd "$(dirname "$SELF")" && pwd)"
PY="$(command -v python3 || command -v python)"
exec "$PY" "$BASE/journal.py" "$@"
