#!/usr/bin/env bash
# ai-work-journal convenience CLI
set -euo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
BASE="$(cd "$(dirname "$SELF")" && pwd)"
CMD="${1:-help}"
shift || true
case "$CMD" in
  collect) exec python3 "$BASE/collect.py" "$@" ;;
  daily)   exec python3 "$BASE/daily.py" "$@" ;;
  weekly)  exec python3 "$BASE/weekly.py" "$@" ;;
  dashboard)
    python3 "$BASE/dashboard.py" "$@"
    xdg-open "$BASE/reports/dashboard.html" >/dev/null 2>&1 || true
    ;;
  install)
    mkdir -p "$HOME/.local/bin"
    ln -sfn "$SELF" "$HOME/.local/bin/journal"
    echo "installed: ~/.local/bin/journal -> $SELF"
    ;;
  feishu)  exec python3 "$BASE/feishu.py" "$@" ;;
  status)
    echo "== services =="
    systemctl --user --no-pager --plain status aw-server.service aw-awatcher.service screenpipe.service 2>/dev/null | grep -E '^●|Active:' || true
    echo "== recent activitywatch event =="
    curl -s --max-time 5 'http://localhost:5601/api/0/buckets/aw-watcher-window_workstation-2700/events?limit=1' | python3 -c "import sys,json; e=json.load(sys.stdin); print(e[0]['data']['app'],'|',e[0]['data']['title'][:50],'@',e[0]['timestamp'][:19]) if e else print('(none)')" || true
    echo "== timers =="
    systemctl --user list-timers --no-pager 2>/dev/null | grep -E 'ai-journal' || true
    echo "== latest reports =="
    ls -t "$BASE/reports" 2>/dev/null | head -3 || true
    ls -t "$BASE/reports/weekly" 2>/dev/null | head -3 || true
    ;;
  *)
    cat <<'EOF'
用法: journal <命令> [日期 YYYY-MM-DD]

  collect   采集某天原始数据(默认今天)
  daily     生成某天日报(缺数据时自动先采集, 完成后推送飞书)
  weekly    生成某天所在周的周报(默认本周)
  dashboard 生成全周期可视化看板并打开
  install   把 journal 装入 ~/.local/bin(全局可用)
  feishu    手动推送一份报告到飞书
  status    查看采集服务与定时任务状态

示例:
  journal daily            # 今天的日报
  journal daily 2026-10-03
  journal weekly
  journal dashboard        # 刷新可视化看板
EOF
    ;;
esac
